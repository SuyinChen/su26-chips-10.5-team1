.row
  .col-12.col-md-8.offset-md-2
    %h1.text-center Edit News Item

    %p
      %strong Representative:
      = link_to @representative.name, representative_path(@representative)

    %p
      %strong Issue:
      = @issue

    - if @articles.empty?
      .alert.alert-warning
        No articles found.
    - else
      %h5.mt-4 Select an article:
      = form_tag representative_new_my_news_item_path(@representative),
                 method: :post do
        - @articles.each_with_index do |article, index|
          .card.mb-3
            .card-body
              .form-check
                = radio_button_tag :article, article['url'], false,
                                   id: "article_#{index}",
                                   class: 'form-check-input'

                = label_tag "article_#{index}", 'Select this article',
                            class: 'form-check-label'

              %p.mt-2
                %strong Title:
                = article['title']

              %p
                %strong Link:
                = link_to article['url'], article['url'],
                          target: '_blank',
                          rel: 'noopener'

              %p
                %strong Description:
                = article['description']

              = hidden_field_tag "articles[#{index}][title]", article['title']
              = hidden_field_tag "articles[#{index}][url]", article['url']
              = hidden_field_tag "articles[#{index}][description]", article['description']
        = hidden_field_tag :issue, @issue

        .mb-3
          = label_tag :rating, 'Rating', class: 'form-label'
          = select_tag :rating,
                       options_for_select(1..5),
                       include_blank: true,
                       class: 'form-select'
        .actions
          = submit_tag 'Save', class: 'btn btn-primary'
          = link_to 'View News Articles',
                    representative_news_items_path(@representative),
                    class: 'btn btn-secondary ms-2'
